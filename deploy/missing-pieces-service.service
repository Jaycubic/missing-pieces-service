[Unit]
Description=The Missing Pieces — EQ puzzle game backend
After=network.target postgresql.service

[Service]
Type=simple
WorkingDirectory=/opt/View/missing-pieces-service
EnvironmentFile=/opt/View/missing-pieces-service/.env
ExecStart=/opt/View/missing-pieces-service/target/release/missing-pieces-service
Restart=on-failure
RestartSec=3
User=www-data

[Install]
WantedBy=multi-user.target
