# Copy this to .env and fill in real values. Never commit the real .env.
DB_NAME=missing_pieces
DB_USER=postgres
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# 0.0.0.0 so the FLAME network can reach it — same reasoning as last time,
# only the database itself stays on localhost.
BIND_ADDR=0.0.0.0
PORT=8091
PUZZLES_DIR=/opt/View/missing-pieces-service/puzzles

RUST_LOG=info
